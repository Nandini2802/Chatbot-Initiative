<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #fff; }
  .card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 8px 32px rgba(0,0,0,.06);
    width: 100%;
    max-width: 420px;
    overflow: hidden;
  }
  .card-top {
    background: linear-gradient(135deg, #16213e 0%, #1a2f5e 100%);
    padding: 24px 28px 20px;
  }
  .label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 6px;
  }
  .title { font-size: 20px; font-weight: 700; color: #fff; }
  .subtitle {
    margin-top: 4px;
    font-size: 12px;
    color: rgba(255,255,255,.5);
  }
  .card-body { padding: 24px 28px; }
  .asset-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    color: #9a9590;
    margin-bottom: 14px;
  }
  .lang-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #faf9f7;
    border-radius: 10px;
    border: 1px solid #eeebe5;
    transition: border-color .15s;
  }
  .lang-item:hover { border-color: #c9a96e; }
  .lang-item--unavailable { opacity: .55; }
  .lang-left { display: flex; align-items: center; gap: 10px; }
  .lang-code {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #fff;
    background: #16213e;
    padding: 3px 8px;
    border-radius: 6px;
    min-width: 34px;
    text-align: center;
  }
  .lang-name { font-size: 14px; font-weight: 500; color: #1a1a1a; }
  .coming-soon {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .5px;
    text-transform: uppercase;
    color: #c9a96e;
    background: rgba(201,169,110,.1);
    padding: 3px 8px;
    border-radius: 10px;
  }
  .available-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }
  .footer {
    padding: 12px 28px;
    background: #faf9f7;
    border-top: 1px solid #f0ede8;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .footer-dot { width: 6px; height: 6px; border-radius: 50%; background: #c9a96e; }
  .footer-text { font-size: 11px; color: #9a9590; }
</style>
</head>
<body>
<div class="card">
  <div class="card-top">
    <div class="label">Available Languages</div>
    <div class="title">{{ project }}</div>
    <div class="subtitle">{{ asset_type | replace('_', ' ') | title }}</div>
  </div>

  <div class="card-body">
    <div class="asset-label">Select a language</div>
    <ul class="lang-list">
      {% for lang in languages %}
      <li class="lang-item {% if not lang.is_available %}lang-item--unavailable{% endif %}">
        <div class="lang-left">
          <span class="lang-code">{{ lang.language_code | upper }}</span>
          <span class="lang-name">{{ lang.language_name }}</span>
        </div>
        {% if lang.is_available %}
        <div class="available-dot"></div>
        {% else %}
        <span class="coming-soon">Soon</span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="footer">
    <div class="footer-dot"></div>
    <span class="footer-text">Danube Properties &mdash; Multilingual Support</span>
  </div>
</div>

</body>
</html>
